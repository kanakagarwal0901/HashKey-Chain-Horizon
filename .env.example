# ==============================================================================
# SHUNYAGRID ENVIRONMENT CONFIGURATION
# The Blind, Zero-Cutoff AI API Token Exchange (ETHGlobal Mumbai 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hedera Hashgraph Testnet Integration (@hashgraph/sdk)
# ------------------------------------------------------------------------------
# Your Hedera Testnet Account ID (e.g. 0.0.591244)
HEDERA_OPERATOR_ID=0.0.591244

# Your Hedera Testnet Private Key (DER, ECDSA, or ED25519 format)
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Target Network (testnet | previewnet | mainnet)
HEDERA_NETWORK=testnet

# Hedera Consensus Service (HCS) Topic ID for tamper-evident audit logs
HEDERA_HCS_TOPIC_ID=0.0.591300

# Hedera Token Service (HTS) USDC Token ID on Testnet
HEDERA_USDC_TOKEN_ID=0.0.429272

# Enable live Mirror Node verification (set to true to query testnet.mirrornode.hedera.com)
HEDERA_LIVE_CHECK=false

# Treasury Hedera Account that holds escrow and protocol commission
SHUNYA_TREASURY_HEDERA_ID=0.0.591244

# ------------------------------------------------------------------------------
# 2. World ID Verification (Worldcoin Developer Portal)
# ------------------------------------------------------------------------------
WORLD_ID_APP_ID=app_staging_shunyagrid
WORLD_ID_ACTION=seller-listing
WORLD_ID_LIVE_CHECK=false

# ------------------------------------------------------------------------------
# 3. Upstream AI Providers (Optional: for testing live sealed enclave calls)
# ------------------------------------------------------------------------------
# Anthropic Claude API Key (begins with sk-ant-)
ANTHROPIC_API_KEY=

# OpenAI API Key (begins with sk- or sk-proj-)
OPENAI_API_KEY=

# Google Gemini API Key (begins with AIza)
GEMINI_API_KEY=

# Groq API Key (begins with gsk_)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. 0G Compute & Storage Network
# ------------------------------------------------------------------------------
ZERO_G_COMPUTE_CONTRACT=0x8849b291d2938192a019e091b29a8f237190abcd
ZERO_G_STORAGE_NODE=https://rpc-storage-testnet.0g.ai
