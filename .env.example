# ==============================================================================
# SHUNYAGRID ENVIRONMENT CONFIGURATION
# Track 2: Agent Payments & A2A Settlement on HashKey Chain Horizon
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HashKey Chain Horizon Testnet (Chain ID: 133)
# ------------------------------------------------------------------------------
HASHKEY_TESTNET_RPC=https://testnet.hsk.xyz
HASHKEY_MAINNET_RPC=https://mainnet.hsk.xyz
HASHKEY_CHAIN_ID=133
HASHKEY_EXPLORER_URL=https://testnet-explorer.hskchain.net

# HashKey Settlement Protocol (HSP) Adapter Contract on HashKey Testnet
NEXT_PUBLIC_HSP_ADAPTER_ADDRESS=0xBe5dDD447CfeA3Ff43ea636F5FCc75434f6f8108
NEXT_PUBLIC_HASHKEY_ROUTER_ADDRESS=0x56B8BaF4a417A90202021cBAc6ba983c8f96D6F3

# ------------------------------------------------------------------------------
# 2. Treasury EVM Multi-Chain Account (Escrow, Protocol Commission & Sweeper)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SHUNYA_TREASURY_EVM_ADDRESS=0xe08798BaCfec631554b02D126b67788Dac3AbaD6
# Private keys: set your funded private keys in .env.local (do not commit real keys)
SHUNYA_TREASURY_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
HASHKEY_DEPLOYER_PRIVATE_KEY=
BUYER_AGENT_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. Multi-Chain RPC Endpoints
# ------------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ------------------------------------------------------------------------------
# 4. World ID Verification (Proof of Humanity for AI Sellers & Node Operators)
# ------------------------------------------------------------------------------
WORLD_ID_APP_ID=app_staging_shunyagrid
WORLD_ID_ACTION=shunyagrid-gate
WORLD_ID_LIVE_CHECK=false

# ------------------------------------------------------------------------------
# 5. Upstream AI Providers (Optional: for testing live sealed enclave calls)
